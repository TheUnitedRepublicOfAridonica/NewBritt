<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Britt City — Realistic Skyline</title>
    <style>
      :root {
        --sky-top: #07131f;
        --sky-mid: #12324d;
        --sky-bottom: #2d4d68;
        --building-1: #182732;
        --building-2: #233748;
        --building-3: #2d435c;
        --building-4: #304e69;
        --glass: #d7ecff;
        --glass-soft: rgba(195, 221, 255, 0.85);
        --gold: #f7d58a;
        --street: #111820;
        --street-line: #e4b55f;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        height: 100%;
        background: linear-gradient(to bottom, var(--sky-top) 0%, var(--sky-mid) 42%, var(--sky-bottom) 100%);
        font-family: "Segoe UI", Tahoma, sans-serif;
        overflow: hidden;
      }

      body {
        display: grid;
        place-items: center;
      }

      .scene {
        position: relative;
        width: min(96vw, 1300px);
        height: min(82vh, 860px);
        background:
          radial-gradient(circle at 50% 18%, rgba(147, 197, 255, 0.25), transparent 17%),
          linear-gradient(to bottom, rgba(255,255,255,0.04), rgba(0,0,0,0.18));
        box-shadow:
          inset 0 0 0 2px rgba(196, 224, 255, 0.12),
          0 30px 90px rgba(0,0,0,0.55);
        overflow: hidden;
      }

      .scene::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(to bottom, rgba(173, 215, 255, 0.12), transparent 30%, rgba(0,0,0,0.22) 100%),
          repeating-linear-gradient(
            0deg,
            rgba(255,255,255,0.03) 0px,
            rgba(255,255,255,0.03) 1px,
            transparent 1px,
            transparent 8px
          );
      }

      .sun {
        position: absolute;
        left: 50%;
        top: 10%;
        width: 260px;
        height: 260px;
        transform: translateX(-50%);
        border-radius: 50%;
        background: radial-gradient(circle, rgba(250,213,125,0.75), rgba(191,151,92,0.18) 40%, transparent 70%);
        filter: blur(8px);
      }

      .cloud {
        position: absolute;
        background: rgba(218, 231, 245, 0.12);
        filter: blur(2px);
        border-radius: 999px;
      }

      .cloud.c1 {
        width: 220px; height: 52px; left: -8%; top: 14%;
        box-shadow: 42px 10px 0 rgba(218,231,245,0.08), 92px 18px 0 rgba(218,231,245,0.06), 148px 8px 0 rgba(218,231,245,0.06);
      }

      .cloud.c2 {
        width: 260px; height: 60px; left: 42%; top: 22%;
        box-shadow: 44px 14px 0 rgba(218,231,245,0.08), 116px 18px 0 rgba(218,231,245,0.06), 180px 6px 0 rgba(218,231,245,0.06);
      }

      .cloud.c3 {
        width: 210px; height: 48px; left: 70%; top: 12%;
        box-shadow: 36px 12px 0 rgba(218,231,245,0.07), 96px 18px 0 rgba(218,231,245,0.05), 150px 5px 0 rgba(218,231,245,0.05);
      }

      .city {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 62%;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: 10px;
        padding: 0 24px 0;
        z-index: 2;
      }

      .building {
        position: relative;
        background: linear-gradient(to right, var(--building-1), var(--building-2), var(--building-3));
        border-left: 3px solid rgba(255,255,255,0.06);
        border-right: 3px solid rgba(255,255,255,0.06);
        box-shadow: inset 0 0 0 2px rgba(0,0,0,0.15);
        overflow: hidden;
      }

      .building::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(90deg, rgba(255,255,255,0.08), transparent 25%, transparent 75%, rgba(255,255,255,0.06)),
          repeating-linear-gradient(
            to bottom,
            rgba(255,255,255,0.04) 0 6px,
            transparent 6px 14px
          );
      }

      .building::after {
        content: "";
        position: absolute;
        inset: auto 0 0 0;
        height: 18px;
        background: linear-gradient(to top, rgba(0,0,0,0.24), transparent);
      }

      .building .windows {
        position: absolute;
        inset: 16px 10px 12px;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
        z-index: 1;
      }

      .building .windows span {
        display: block;
        background: rgba(19, 30, 40, 0.9);
        border: 1px solid rgba(255,255,255,0.04);
        box-shadow: inset 0 0 0 1px rgba(0,0,0,0.25);
        animation: glow 4s ease-in-out infinite alternate;
        animation-delay: var(--d);
      }

      @keyframes glow {
        0%, 100% {
          background: rgba(19, 30, 40, 0.9);
          box-shadow: inset 0 0 0 1px rgba(0,0,0,0.25), 0 0 0 rgba(247,213,138,0);
        }
        35%, 68% {
          background: rgba(247, 213, 138, 0.9);
          box-shadow: inset 0 0 0 1px rgba(0,0,0,0.15), 0 0 12px rgba(247,213,138,0.4);
        }
      }

      .b1 { width: 52px; height: 110px; }
      .b2 { width: 74px; height: 150px; }
      .b3 { width: 64px; height: 190px; }
      .b4 { width: 88px; height: 260px; }
      .b5 { width: 116px; height: 330px; }
      .b6 { width: 108px; height: 240px; }
      .b7 { width: 80px; height: 160px; }
      .b8 { width: 96px; height: 290px; }
      .b9 { width: 72px; height: 120px; }

      .tower-wrap {
        position: absolute;
        left: 50%;
        bottom: 0;
        transform: translateX(-50%);
        width: 340px;
        height: 560px;
        z-index: 5;
      }

      .tower {
        position: relative;
        width: 100%;
        height: 100%;
        background: linear-gradient(to bottom, #435f7f 0%, #2a445e 18%, #192939 50%, #101820 100%);
        border-left: 8px solid rgba(255,255,255,0.08);
        border-right: 8px solid rgba(255,255,255,0.08);
        box-shadow:
          inset 0 0 0 4px rgba(255,255,255,0.04),
          0 0 32px rgba(95, 175, 255, 0.12);
        clip-path: polygon(18% 0, 82% 0, 100% 100%, 0 100%);
        overflow: hidden;
      }

      .tower::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(90deg, rgba(255,255,255,0.08), transparent 16%, transparent 84%, rgba(255,255,255,0.08)),
          repeating-linear-gradient(
            to bottom,
            rgba(255,255,255,0.05) 0 5px,
            transparent 5px 15px
          );
      }

      .tower .roof {
        position: absolute;
        left: 50%;
        top: 64px;
        transform: translateX(-50%);
        width: 180px;
        height: 18px;
        background: linear-gradient(to right, #9bb7d6, #4c6386, #9bb7d6);
        box-shadow: 0 0 18px rgba(145, 195, 255, 0.18);
      }

      .tower .sign {
        position: absolute;
        left: 50%;
        top: 102px;
        transform: translateX(-50%);
        width: 210px;
        height: 86px;
        display: grid;
        place-items: center;
        background: linear-gradient(180deg, rgba(8, 18, 32, 0.92), rgba(17, 21, 36, 0.94));
        border: 4px solid rgba(169, 220, 255, 0.8);
        box-shadow:
          0 0 0 3px rgba(125, 196, 255, 0.13),
          0 0 26px rgba(125, 196, 255, 0.15);
        clip-path: polygon(7% 0, 93% 0, 100% 50%, 93% 100%, 7% 100%, 0 50%);
      }

      .tower .sign span {
        font-size: clamp(16px, 1vw, 22px);
        letter-spacing: 0.32em;
        color: #dff6ff;
        font-weight: 900;
        text-transform: uppercase;
        text-shadow: 0 0 18px rgba(138, 214, 255, 0.8);
        white-space: nowrap;
      }

      .tower .spire {
        position: absolute;
        left: 50%;
        top: -48px;
        transform: translateX(-50%);
        width: 66px;
        height: 66px;
        background: linear-gradient(to bottom, #fbe7a5, #d2961d 70%, #845b11);
        clip-path: polygon(50% 0%, 100% 100%, 0 100%);
        box-shadow: 0 0 24px rgba(247, 213, 138, 0.75);
      }

      .tower .antenna {
        position: absolute;
        left: 50%;
        top: -128px;
        width: 5px;
        height: 80px;
        transform: translateX(-50%);
        background: rgba(220, 240, 255, 0.96);
        box-shadow: 0 0 10px rgba(255,255,255,0.7);
      }

      .tower .antenna::before {
        content: "";
        position: absolute;
        left: 50%;
        top: -14px;
        transform: translateX(-50%);
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: #8ce9ff;
        box-shadow: 0 0 16px rgba(140, 233, 255, 0.8);
      }

      .tower .windows {
        position: absolute;
        inset: 190px 26px 20px 26px;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        z-index: 1;
      }

      .tower .windows span {
        display: block;
        width: 100%;
        height: 48px;
        background: rgba(17, 31, 42, 0.9);
        border: 1px solid rgba(255,255,255,0.05);
        animation: towerGlow 3.2s ease-in-out infinite alternate;
        animation-delay: calc(var(--i) * 0.15s);
      }

      @keyframes towerGlow {
        0%, 100% {
          background: rgba(17, 31, 42, 0.9);
          box-shadow: inset 0 0 0 1px rgba(0,0,0,0.25), 0 0 0 rgba(255,216,120,0);
        }
        35%, 65% {
          background: rgba(255, 216, 120, 0.9);
          box-shadow: inset 0 0 0 1px rgba(0,0,0,0.12), 0 0 12px rgba(255,216,120,0.45);
        }
      }

      .street {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 90px;
        background: linear-gradient(to bottom, #121b22 0%, #0a0d12 100%);
        border-top: 6px solid rgba(255,255,255,0.08);
        z-index: 10;
      }

      .street::before {
        content: "";
        position: absolute;
        inset: 8px 0 0 0;
        background:
          repeating-linear-gradient(
            90deg,
            rgba(228, 181, 95, 0.9) 0 12px,
            transparent 12px 42px
          );
        opacity: 0.7;
      }

      .street::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, transparent, rgba(0,0,0,0.45));
      }

      .haze {
        position: absolute;
        inset: auto 0 68px 0;
        height: 120px;
        background: linear-gradient(to bottom, transparent, rgba(140, 194, 255, 0.12), transparent);
        z-index: 3;
      }

      @media (max-width: 760px) {
        .city {
          gap: 6px;
          padding: 0 12px 0;
        }

        .b5 { width: 92px; }
        .b8 { width: 76px; }
        .tower-wrap { width: 220px; height: 430px; }
        .tower .sign { width: 150px; height: 62px; }
        .tower .sign span {
          letter-spacing: 0.18em;
          font-size: 12px;
        }
      }
    </style>
  </head>
  <body>
