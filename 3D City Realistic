            <span style="--d:1.7s"></span>
            <span style="--d:0.3s"></span>
            <span style="--d:1.2s"></span>
            <span style="--d:1.9s"></span>
            <span style="--d:0.6s"></span>
            <span style="--d:1.1s"></span>
          </div>
        </div>

        <div class="building b5">
          <div class="windows">
            <span style="--d:0.1s"></span>
            <span style="--d:0.9s"></span>
